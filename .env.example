# ======================================================================
# 熊猫笔记 · 项目环境变量（统一模板）
# ======================================================================
# 这是项目所有环境变量的唯一模板（Single Source of Truth）。
# 前端、后端、运维监控面板都从此模板复制生成各自的 .env。
#
# ⚠️  安全规则（严格执行）
#     1. 复制本文件为 .env 后再填入真实值，绝不修改本示例文件
#     2. .env 文件必须加入 .gitignore，绝不提交到任何仓库
#     3. 生产环境必须替换所有占位（尤其是 JWT_SECRET / SSH_KEY / 数据库密码）
#     4. 所有密码和密钥使用 >= 32 位的随机字符串，不含空格
#     5. 文档、注释、代码中绝不出现真实凭据
#
# ⚠️  生产部署前必改清单：
#     1. APP_VERSION             — 从 package.json 同步
#     2. DATABASE_URL            — 生产数据库连接字符串
#     3. JWT_SECRET              — 64 位以上随机字符串
#     4. SSH_KEY_PATH            — SSH 私钥路径（替代密码登录）
#     5. SERVER_*                — 生产服务器地址与认证方式
#
# 生成强密码命令（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
# ======================================================================

# ---------- 应用基础 ----------
# 版本号（单一来源，所有子模块都从这里读取）
APP_VERSION=1.1.0.0044
# 运行环境：development | production
NODE_ENV=development

# ---------- 后端服务 ----------
# 后端服务端口
BACKEND_PORT=3002
# 后端健康检查接口（运维面板用）
BACKEND_HEALTH_URL=http://127.0.0.1:3002/api/version

# ---------- 前端服务 ----------
# 前端服务端口
FRONTEND_PORT=3000
# 前端地址（CORS 白名单，多个以英文逗号分隔）
FRONTEND_URL=http://localhost:3001,http://localhost:3000
# 运维面板端口
OPS_MONITOR_PORT=8899

# ---------- 数据库连接（绝不在任何文档或代码中写真实密码）----------
# 格式: postgresql://用户名:密码@主机:端口/数据库名?schema=public
DATABASE_URL=postgresql://navlog:your-database-password-here@106.14.57.62:5432/navlog?schema=public

# ---------- 认证与加密 ----------
# JWT 签名密钥（生产环境必须替换为 64 位以上随机字符串）
JWT_SECRET=your-64-character-jwt-secret-key-replace-in-production-please
JWT_EXPIRES_IN=7d

# ---------- AI 服务 ----------
# 豆包/火山引擎 等第三方服务
AI_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
AI_API_KEY=your-ai-api-key
AI_ENDPOINT_ID=your-endpoint-id

# ---------- 生产服务器 SSH 连接（使用密钥认证，严禁密码认证）----------
# 服务器公网 IP / 域名
SERVER_IP=106.14.57.62
# SSH 端口（生产环境建议修改，不使用默认 22）
SERVER_SSH_PORT=22
# SSH 登录用户名
SERVER_USER=root
# SSH 私钥文件路径（建议使用 ed25519 密钥对）
#   生成命令：ssh-keygen -t ed25519 -f ~/.ssh/panda-nav-server -C "nav-log-deploy"
#   部署到服务器：ssh-copy-id -i ~/.ssh/panda-nav-server root@106.14.57.62
SSH_KEY_PATH=C:/Users/your-user/.ssh/panda-nav-server
# SSH 私钥的 passphrase（如果创建时设置了保护密码，留空表示无密码）
SSH_KEY_PASSPHRASE=
# 服务器后端部署目录
SERVER_BACKEND_DIR=/www/wwwroot/nav-log-system/backend
# 服务器前端部署目录
SERVER_FRONTEND_DIR=/www/wwwroot/nav-log-system/frontend
