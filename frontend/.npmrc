# // ====== v10-v20 旧版配置（已全部注释掉，运行成功后删除）====================================
# # 【CI 安全 · v0816-20】：.npmrc 只放 old-space（影响所有 npm 进程包括 install）
# #   --gc-interval=100 只放 NODE_OPTIONS（只影响 nuxt build，不影响 npm install）
# node-options=--max-old-space-size=8192 --max-semi-space-size=8 --expose-gc
# fetch-timeout=600000
# // ====== 以上全部注释掉 ========================================================================

# ★ v21 干净版：只给 old-space=6144（6GB）
#   v16(4096) → V8 FATAL used=3820（不够）
#   v18(8192) → cgroup SIGKILL（RSS超 cgroup limit ~8GB）
#   → 6144 正好在中间：应用 ~3.8GB + V8 预留 + 非堆 ≈ 6.5GB < cgroup ~8GB
#   其他 gc-interval/expose-gc 全不用，让 V8 用自己的默认策略
node-options=--max-old-space-size=6144
fetch-timeout=600000
