# ============================================================
# 熊猫笔记 · 运维监控面板 - 环境变量（示例）
#
# 所有凭据必须从 .env 文件读取，严禁硬编码
# 本文件是模板，不含真实密码，可提交到版本库
# 实际使用：cp .env.example .env 然后填入真实值
#
# 安全规则：
#   1. .env 文件已加入 .gitignore，严禁提交
#   2. SSH 连接必须使用密钥认证（Public Key Authentication），严禁密码认证
#   3. 数据库连接通过 DATABASE_URL 配置，用户/密码在 URL 中，但 URL 本身在 .env
#   4. 生成密钥：ssh-keygen -t ed25519 -f ~/.ssh/panda-nav-server -C "nav-log-deploy"
#   5. 部署公钥：ssh-copy-id -i ~/.ssh/panda-nav-server root@YOUR_SERVER_IP
# ============================================================

# ---------- 路径配置 ----------
PROJECT_DIR=D:/PYwork/熊猫笔记/nav-log-system
BACKEND_SUBDIR=backend
FRONTEND_SUBDIR=frontend

# ---------- 端口配置 ----------
BACKEND_PORT=3002
FRONTEND_PORT=3000
MONITOR_PORT=8899

# ---------- 健康检查 URL ----------
BACKEND_HEALTH_URL=http://127.0.0.1:3002/api/version
FRONTEND_TEST_URL=http://127.0.0.1:3000/

# ---------- 生产服务器 SSH 配置（密钥认证） ----------
SERVER_IP=106.14.57.62
SERVER_USER=root
SERVER_SSH_PORT=22
# SSH 私钥文件路径（ed25519 推荐）
SSH_KEY_PATH=C:/Users/your-user/.ssh/panda-nav-server
# SSH 私钥的保护密码（可选，留空表示无密码）
SSH_KEY_PASSPHRASE=
SERVER_BACKEND_DIR=/www/wwwroot/nav-log-system/backend
SERVER_FRONTEND_DIR=/www/wwwroot/nav-log-system/frontend

# ---------- 数据库连接（仅用于运维面板的健康检查） ----------
DATABASE_URL=postgresql://navlog:YOUR_DB_PASSWORD@106.14.57.62:5432/navlog?schema=public

# ---------- 运行环境 ----------
NODE_ENV=development
