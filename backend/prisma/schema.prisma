generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 团队枚举
enum TeamCode {
  team1
  team2
  team3
}

// 用户角色枚举（4级架构）
enum UserRole {
  admin                     // 0级：超级管理员（拥有所有权限，可切换任意角色）
  ship_political_instructor  // 4级：船舶政委
  shore_crew_supervisor     // 3级：岸基船工主管（MVP重点）
  shore_marine_supervisor   // 3级：岸基海务主管（预留）
  shore_engineer_supervisor // 3级：岸基机务主管（预留）
  shore_electric_supervisor // 3级：岸基电气主管（预留）
  general_manager           // 2级：总管团队（预留）
  company_admin             // 1级：油轮船管部（预留）
}

// 日程/任务状态枚举
enum ScheduleStatus {
  pending
  in_progress
  completed
  cancelled
}

// 优先级枚举
enum Priority {
  urgent_important // 重要紧急
  important        // 重要不紧急
  urgent           // 紧急不重要
  normal           // 不紧急不重要
  low              // 低（向后兼容）
}

// 用户表
model User {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  password    String
  realName    String
  teamCode    TeamCode
  role        UserRole // 当前活跃角色（用于切换）
  roles       UserRole[] @default([shore_crew_supervisor]) // 可访问的所有角色列表
  lastLoginAt DateTime?
  loginFailCount Int     @default(0)
  lockedUntil DateTime?
  passwordChanged Boolean @default(false)

  // 政委个人信息字段（批量导入时填充）
  birthDate       DateTime? // 出生年月
  idNumber        String?   // 身份证号
  englishName     String?   // 英文名
  gender          String?   // 性别
  nationality     String?   // 国籍
  hometown        String?   // 籍贯
  politicalStatus String?   // 政治面貌
  phoneNumber     String?   // 手机号
  employeeNo      String?   // 船员工号
  dataSource      String?   // 数据来源

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdSchedules Schedule[] @relation("CreatedBy")
  assignedSchedules Schedule[] @relation("AssignedTo")
  operationLogs OperationLog[]
  updatedSopFlows SopFlow[]
  uploadedFiles SharedFile[]
  fileComments FileComment[]
  createdTasks Task[] @relation("TaskCreatedBy")
  assignedTasks Task[] @relation("TaskAssignedTo")
  authoredExperiences Experience[] @relation("ExperienceAuthor")
  experienceComments ExperienceComment[] @relation("ExperienceCommentUser")
  experienceRatings ExperienceRating[]
  experiencePermissions ExperiencePermission[] @relation("ExperiencePermissionUser")
  partyActivitiesCreated PartyActivity[] @relation("PartyActivityCreatedBy")
  partyActivityComments PartyActivityComment[] @relation("PartyActivityCommentUser")
  studyRecords StudyRecord[] @relation("StudyRecordUser")
  thoughtReports ThoughtReport[] @relation("ThoughtReportUser")
  integrityRecords IntegrityRecord[] @relation("IntegrityRecordUser")
  officerProfiles OfficerProfile[] @relation("OfficerProfileUser")
  evaluationsGiven OfficerEvaluation[] @relation("EvaluationEvaluator")
  evaluationsReceived OfficerEvaluation[] @relation("EvaluationOfficerUser")
  mentorshipRecords MentorshipRecord[] @relation("MentorshipMentor")
  mentorshipRecordsMentee MentorshipRecord[] @relation("MentorshipMenteeUser")
  appealRecords AppealRecord[] @relation("AppealRecordUser")
  staffAssignments StaffAssignment[]
  createdFileCollections FileCollection[]
  fileSubmissions FileSubmission[]
  createdStandardTaskTemplates StandardTaskTemplate[] @relation("StandardTaskTemplateCreatedBy")
  recurringScheduleTemplatesAssigned RecurringScheduleTemplate[] @relation("RecurringScheduleAssignedTo")
  recurringScheduleTemplatesCreated RecurringScheduleTemplate[] @relation("RecurringScheduleCreatedBy")
  diaryBlocks  DiaryBlock[]
  importantDates ImportantDate[]
  scheduleReminders ScheduleReminder[]
  scheduleSettings ScheduleSettings?

  @@index([username])
}

// 船舶静态档案表
model Ship {
  id                    Int       @id @default(autoincrement())
  teamCode             TeamCode
  cnShipName           String
  enShipName           String?
  flagCountry          String?
  portRegistry         String?
  shipType             String?
  deadweightTonnage    String?
  factoryDate          String?
  teamDisplayName      String?
  tradeType            String?   // 内外贸：外贸/内外贸兼营
  marineSupervisor     String?
  engineerSupervisor   String?
  electricSupervisor   String?
  crewSupervisor       String?
  politicalInstructor String?
  instructorIdNumber String?   // 政委身份证号（用于生日提醒等功能）
  onBoardDate          String?
  daysOnBoard          String?
  sendCompany          String?
  sendRuleNote         String?
  buildYear            Int?
  
  // 船舶动态信息
  currentVoyage        String?   // 当前航次
  currentLocation      String?   // 当前位置
  currentStatus        String    @default("voyage") // voyage/anchored/berthed
  eta                  DateTime? // 预计抵港时间
  etaPort              String?   // 目的港
  etd                  DateTime? // 预计离港时间

  // 船舶报告扩展字段（来源：船工主管粘贴微信报告）
  cargoStatus          String?   // 载货状态（满载/空载/压载等）
  departurePort        String?   // 出发港
  visibility           String?   // 能见度
  temperature          String?   // 气温
  windDirection        String?   // 风向
  windForce            String?   // 风力
  waveLevel            String?   // 浪级
  timezone             String?   // 当前时区（如 GMT+8）
  focusPoints          String?   @db.Text // 关注重点
  otherNotes           String?   @db.Text // 其它说明
  dynamicSource        String?   // 动态数据来源：supervisor(船工主管粘贴)
  dynamicUpdatedAt     DateTime? // 动态数据最后更新时间
  
  // 政委报告独立字段（来源：政委日记同步，与船舶报告独立保存）
  politicalVoyage      String?   // 航次
  politicalLocation    String?   // 当前位置
  politicalStatus      String?   // 当前状态
  politicalETA         DateTime? // 预计抵港时间
  politicalETAPort     String?   // 目的港
  politicalETD         DateTime? // 预计离港时间
  politicalWeather     String?   // 天气
  politicalSeaCondition String?  // 海况
  politicalStaffChange String?   // 人员变更
  politicalFocusPoints String?   @db.Text // 关注重点
  politicalOtherNotes  String?   @db.Text // 其它说明
  politicalUpdatedAt   DateTime? // 政委报告最后更新时间
  
  // 区域标记（用于卡片显示特殊标记）
  etaPortRegion        String?   // 目的港区域：fiveEyes(五眼联盟)/europe(欧洲)/piracy(海盗区)/other
  piracyZone           Boolean?  @default(false) // 是否去海盗区
  
  // 当前政委信息
  politicalOfficerId   Int?      // 政委用户ID
  politicalOfficerName String?   // 政委姓名
  politicalOfficerPhoto String?  // 政委照片URL
  captainName          String?   // 船长姓名
  shipPhoto            String?   // 船舶照片URL
  
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([teamCode, cnShipName])
  @@index([teamCode])
  @@index([cnShipName])
  @@index([currentStatus])
  @@index([eta])

  staffHistory StaffHistory[]
  staffAssignments StaffAssignment[]
  schedules    Schedule[]
  partyActivities PartyActivity[]
  submissions  FileSubmission[]
  healthReports HealthReportUpload[]
  partyConfig  ShipPartyConfig?
  recurringScheduleTemplates RecurringScheduleTemplate[]
  diaryBlocks  DiaryBlock[]
}

// 船舶党建差异化配置表（一船一策）
model ShipPartyConfig {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  shipId        Int       @unique // 每船一条配置
  config        Json      @default("{}") // 差异化配置JSON
  updatedBy     Int?      // 最后更新人
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ship          Ship      @relation(fields: [shipId], references: [id])

  @@index([teamCode])
  @@index([teamCode, shipId])
}

// 人员任职履历时序表
model StaffHistory {
  id          Int       @id @default(autoincrement())
  teamCode    TeamCode
  shipId      Int
  postName    String
  staffName   String
  startDate   DateTime
  endDate     DateTime? // 为空表示在岗
  handoverNote String?
  createdAt   DateTime  @default(now())

  ship Ship @relation(fields: [shipId], references: [id])

  @@index([teamCode, shipId])
}

// 日程/工作台账表（主管统计唯一数据源）
model Schedule {
  id           Int            @id @default(autoincrement())
  teamCode     TeamCode
  recordDate   DateTime
  shipId       Int?
  firstType    String         // 一级分类（统计主数据源）
  secondType   String         // 二级分类（统计主数据源）
  standardFlowId Int?
  eventDetail  String?
  title        String?
  description  String?
  startTime    DateTime?
  endTime      DateTime?
  finishStatus ScheduleStatus @default(pending) // 完成状态（统计主数据源）
  priority     Priority       @default(normal)
  createdById  Int
  assignedToId Int?
  taskId       Int? // 关联任务ID

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  ship         Ship?         @relation(fields: [shipId], references: [id])
  createdBy    User          @relation("CreatedBy", fields: [createdById], references: [id])
  assignedTo   User?         @relation("AssignedTo", fields: [assignedToId], references: [id])
  sopFlow      SopFlow?      @relation(fields: [standardFlowId], references: [id])
  publicCases  PublicCase[]
  task         Task?         @relation(fields: [taskId], references: [id])

  // 反向关联：一条日程可被多条日记引用
  relatedDiaries DiaryScheduleRelation[]
  diaryBlocks  DiaryBlock[]
  reminders ScheduleReminder[]

  @@index([teamCode, recordDate])
  @@index([teamCode, shipId])
  @@index([teamCode, finishStatus])
  @@index([updatedAt])
  @@index([taskId])
  // P0优化新增：为统计优化的组合索引
  @@index([teamCode, firstType, secondType])
  @@index([teamCode, finishStatus, recordDate])
}

// ============================================
// 重要日（生日/纪念日/考试等，对标华为日历"重要日"Tab）
// ============================================
model ImportantDate {
  id           Int      @id @default(autoincrement())
  teamCode     TeamCode
  userId       Int     // 创建者
  name         String  // 名称（考试、生日、重要日...）
  date         DateTime // 日期
  repeatType   String   @default("none") // none/yearly/monthly/weekly
  description  String?  @db.Text
  attachments  Json?    // 附件列表（URL数组）

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id])

  @@index([teamCode, date])
  @@index([teamCode, userId])
  @@index([teamCode, repeatType])
}

// ============================================
// 日程提醒（对标华为日历"提醒：10分钟前"）
// ============================================
model ScheduleReminder {
  id           Int      @id @default(autoincrement())
  teamCode     TeamCode
  scheduleId   Int      // 关联日程
  userId       Int     // 创建者
  remindBefore Int     // 提前多少分钟
  remindUnit   String   @default("minute") // minute/hour/day
  isImportant  Boolean  @default(false) // 重要提醒
  firedAt      DateTime? // 已触发时间（null=未触发）

  createdAt    DateTime @default(now())

  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id])

  @@index([teamCode, scheduleId])
  @@index([teamCode, userId])
  @@index([teamCode, firedAt])
}

// ============================================
// 用户日历偏好设置（对标华为日历"设置"面板）
// ============================================
model ScheduleSettings {
  id                   Int      @id @default(autoincrement())
  teamCode             TeamCode
  userId               Int      @unique // 一个用户一条设置

  showLunar            Boolean  @default(true)   // 显示农历
  showWeekNumber       Boolean  @default(false)  // 显示周数
  showHolidayRest      Boolean  @default(true)   // 显示节假日休班
  showHistoricalEvents Boolean  @default(true)   // 显示历史事件
  weekStartDay         Int      @default(0)      // 一周开始日（0=周日, 1=周一）
  syncTodo             Boolean  @default(false)  // 同步待办
  showImportantDate    Boolean  @default(true)   // 显示重要日
  recommendSubscribe   Boolean  @default(true)   // 推荐订阅
  otherCalendar        String   @default("chinese_lunar") // 其他历法

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id])

  @@index([teamCode, userId])
}

// 操作日志表
model OperationLog {
  id               Int      @id @default(autoincrement())
  userId           Int
  teamCode         TeamCode
  operationType    String
  operationContent String?
  ipAddress        String?
  userAgent        String?
  requestParams    Json?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([teamCode, userId])
  @@index([createdAt])
}

// 分类字典表
model DictCategory {
  id          Int       @id @default(autoincrement())
  teamCode    TeamCode?
  role        UserRole? // 关联用户类别（角色），为空表示全局共享
  categoryType String // first_type/second_type
  categoryName String
  parentId    Int?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([teamCode, categoryType])
  @@index([role])
}

// 标准任务库模板表（预设的标准任务，可快速创建日程）
model StandardTaskTemplate {
  id           Int       @id @default(autoincrement())
  teamCode     TeamCode? // 团队代码，空为全局共享
  firstType    String    // 一级分类
  secondType   String    // 二级分类
  title        String?   // 任务标题（可选）
  eventDetail  String?   // 任务详情（可选）
  priority     String    @default("normal") // normal/high/urgent
  sortOrder    Int       @default(0)
  createdById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy    User?     @relation("StandardTaskTemplateCreatedBy", fields: [createdById], references: [id])

  @@index([teamCode, firstType, secondType])
  @@index([teamCode, sortOrder])
}

// 定期任务模板表（自动生成日程任务）
model RecurringScheduleTemplate {
  id           Int       @id @default(autoincrement())
  teamCode     TeamCode
  templateName String    // 模板名称（如"周一安全例会"）
  firstType    String    // 一级分类
  secondType   String    // 二级分类
  eventDetail  String?   // 任务详情
  priority     String    @default("normal") // normal/high/urgent
  
  // 执行频率配置
  frequency    String    // daily/weekly/monthly
  dayOfWeek    Int?      // 周几执行（0-6，0=周日），weekly时使用
  dayOfMonth   Int?      // 每月几号执行（1-31），monthly时使用
  executeTime  String    @default("09:00") // 执行时间（HH:mm格式）
  
  // 分配配置
  shipId       Int?      // 指定船舶，空表示所有船舶
  assignedToId Int?      // 指定负责人，空表示不指定
  
  // 状态控制
  isActive     Boolean   @default(true) // 是否启用
  lastExecutedAt DateTime? // 上次执行时间
  nextExecuteAt DateTime? // 下次执行时间
  
  createdById  Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  ship         Ship?     @relation(fields: [shipId], references: [id])
  assignedTo   User?     @relation("RecurringScheduleAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User?     @relation("RecurringScheduleCreatedBy", fields: [createdById], references: [id])

  @@index([teamCode, isActive])
  @@index([nextExecuteAt])
  @@index([frequency])
}

// SOP标准流程字典表（全团队共享）
model SopFlow {
  id          Int       @id @default(autoincrement())
  flowName    String
  flowContent String
  firstType   String?
  secondType  String?
  updatedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  updatedBy User?      @relation(fields: [updatedById], references: [id])
  schedules Schedule[]

  @@index([flowName])
  @@index([firstType, secondType])
}

// 公共脱敏案例知识库（全团队共享）
model PublicCase {
  id            Int       @id @default(autoincrement())
  fromRecordId  Int? // 源工单ID（后台溯源）
  caseType      String
  caseContent   String
  createdAt     DateTime  @default(now())

  fromRecord Schedule? @relation(fields: [fromRecordId], references: [id])

  @@index([caseType])
}

// AI配置表
model AiConfig {
  id          Int       @id @default(autoincrement())
  teamCode    TeamCode
  apiKey      String // 加密存储
  apiEndpoint String
  modelName   String    @default("doubao-pro")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([teamCode])
}

// 航海日记表
model Diary {
  id            Int       @id @default(autoincrement())
  userId        Int
  teamCode      TeamCode
  shipId        Int?
  date          DateTime
  content       String    @db.Text
  weather       String?
  seaCondition  String?
  dynamicStatus String?
  departurePort String?
  arrivalPort   String?
  voyageNumber  String?
  departureDate DateTime?
  arrivalDate   DateTime?
  departureTime DateTime?
  pirateStatus  String?
  pirateTime    String?
  shipName      String?
  timezone      String?   @default("UTC+8")
  shipPosition  String?
  isFreePortZone      Boolean? @default(false)
  isWarZone           Boolean? @default(false)
  leadSealOperation   Boolean? @default(false)
  categoryFirst String?   // 一级分类（保留以兼容历史数据，新数据优先从关联日程继承）
  categorySecond String?  // 二级分类（保留以兼容历史数据，新数据优先从关联日程继承）
  categorySource String?  @default("manual") // manual=手动填写（历史数据） / auto=自动从关联日程继承

  // 政委信息
  politicalInstructorName String? // 政委姓名
  politicalInstructorOnBoardDate DateTime? // 政委上船时间

  // 多对多关联：一条日记可关联多条已完成日程
  relatedSchedules DiaryScheduleRelation[]

  // 行级块（日记/待办/备忘混排）
  blocks DiaryBlock[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([teamCode, userId, date])
  @@index([teamCode, userId, date])
  @@index([categoryFirst])
  @@index([categorySecond])
  @@index([categorySource])
}

// 日记-日程关联表（多对多）
model DiaryScheduleRelation {
  id          Int      @id @default(autoincrement())
  teamCode    TeamCode
  diaryId     Int
  scheduleId  Int
  createdAt   DateTime @default(now())

  diary    Diary    @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([diaryId, scheduleId])
  @@index([teamCode, diaryId])
  @@index([teamCode, scheduleId])
}

// 日记行级块（支持 日记/待办/备忘 混排、图片、文件、链接、拖拽排序）
enum DiaryBlockType {
  diary    // 日记：对事件的描述
  todo     // 待办：需要完成的事项
  memo     // 备忘：提醒性信息
  image    // 图片
  file     // 文件附件
  link     // 超链接
}

model DiaryBlock {
  id           Int            @id @default(autoincrement())
  diaryId      Int
  userId       Int
  teamCode     TeamCode
  sortOrder    Int            @default(0) // 展示顺序，同日记内递增
  blockType    DiaryBlockType @default(diary)
  content      String         @db.Text
  // todo 专用
  todoStatus   String?        // pending / completed
  todoDueDate  DateTime?
  // 块内容元信息（JSON，image/file/link 的 url、name、size 等）
  metaJson     String?        @db.Text
  // AI 识别关联
  aiSuggested  DiaryBlockType? // AI 建议的类型
  userChanged  Boolean        @default(false) // 用户是否手动修改过类型（用于自学习）
  detectedShipId   Int?          // AI 识别出的关联船舶
  detectedShipName String?        // 冗余存储船舶名，便于查询
  // 关联到 Schedule 表（todo 类型块复用现有日程系统）
  scheduleId   Int?

  diary      Diary     @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])
  ship       Ship?     @relation(fields: [detectedShipId], references: [id])
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([diaryId, sortOrder])
  @@index([userId, blockType])
  @@index([userId, blockType, todoStatus])
  @@index([detectedShipId, todoStatus])  // 船舶卡片快速查询
  @@index([teamCode])
}

// 自学习：用户手动纠正块类型的历史记录（用于关键词权重训练）
model DiaryBlockClassificationLog {
  id             Int            @id @default(autoincrement())
  userId         Int
  teamCode       TeamCode
  aiSuggested    DiaryBlockType // AI 建议的类型
  userCorrected  DiaryBlockType // 用户实际修改的类型
  content        String         @db.Text // 块内容文本（关键词抽取源）
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@index([teamCode])
  @@index([aiSuggested, userCorrected])
}

// 港口信息表
model Port {
  id        Int       @id @default(autoincrement())
  name      String
  english   String?
  country   String
  pinyin    String?
  code      String?
  createdAt DateTime  @default(now())

  @@unique([name, country])
  @@index([name])
  @@index([country])
  @@index([pinyin])
}

// 发布模板表（统一：船舶动态 + 抵港前检查）
model PublishTemplate {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  
  // 任务类型：checklist(勾选清单) | file_collect(文件收集) | ai_survey(AI分析) | photo_checkin(拍照打卡) | form_collect(收集表) | ship_dynamic(船舶动态-兼容旧) | port_call_check(到港检查-兼容旧)
  templateType  String    @default("form_collect")
  title         String    
  items         Json      // 字段定义数组：[{name,label,type,required,options,defaultValue,helpText,maxCount,showInSummary,aiAnalyze}]
  targetShips   Json?     // 目标船舶ID数组
  triggerDays   Int?      // 触发天数
  
  // 新增：模板元数据
  templateDesc  String?   // 模板描述
  coverImage    String?   // 封面图URL
  categoryId    Int?      // 分类ID
  category      TaskCategory? @relation(fields: [categoryId], references: [id])
  
  // 新增：发布规则
  frequencyType String?   @default("once") // once | daily | weekly | monthly | custom
  frequencyCron String?   // cron表达式
  reminderEnabled Boolean @default(false)
  reminderDaysBefore Json? // 提醒日期，如 [3,1,0]
  
  // 截止时间（百宝箱可视化配置中心新增）
  deadline       DateTime? // 任务截止时间
  
  // 新增：AI配置
  aiEnabled     Boolean   @default(false)
  aiPromptTemplate String? // AI分析提示词
  aiOutputFormat String?  @default("summary") // summary | bullet_points | metric_extraction | full_report
  
  // 新增：看板指标
  dashboardMetrics Json?  // [{code,label,field,type}]
  
  // 新增：模板类型标记
  isSystem      Boolean   @default(false)  // 是否系统预设模板
  sourceTaskId  Int?      // 来源任务ID（从历史任务创建模板时记录）
  creatorRole   String?   // 创建者角色（海务/机务/船工/电工/政委）
  
  // 新增：文件收集配置
  fileNamingRule String?  // 规范命名规则（船名_日期_类型_序号）
  allowedTypes  Json?     // 允许的文件类型
  
  // 新增：进度跟踪配置（checklist专用）
  progressTracking Boolean @default(false)
  
  isDraft       Boolean   @default(true)
  isPublished   Boolean   @default(false)
  publishedBy   Int?      
  publishedAt   DateTime? 
  
  version       Int       @default(1)
  usageCount    Int       @default(0)
  
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // 关联
  shipTasks     ShipTaskStatus[]
  
  @@index([teamCode])
  @@index([templateType])
  @@index([isDraft])
  @@index([isPublished])
  @@index([categoryId])
  @@index([isSystem])
  @@index([sourceTaskId])
}

// 模板分类表
model TaskCategory {
  id          Int      @id @default(autoincrement())
  teamCode    TeamCode
  name        String   // 分类名称：船员管理 / 航行安全 / 设备维护 / 港口业务 / 质量管理
  icon        String?  // emoji图标
  color       String?  // 主题色
  sortOrder   Int      @default(0)
  parentId    Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templates   PublishTemplate[]

  @@index([teamCode])
  @@index([parentId])
}

// 船舶任务状态表
model ShipTaskStatus {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  shipId        Int       
  templateId    Int       
  templateType  String    
  template      PublishTemplate? @relation(fields: [templateId], references: [id])
  responseData  Json?     // 填写数据
  totalItems    Int       @default(0)
  completedItems Int      @default(0)
  progress      Float     @default(0)
  status        String    @default("pending") // pending | in_progress | completed | expired
  respondedBy   Int?      
  respondedAt   DateTime? 
  triggerDate   DateTime? 

  // 新增：GPS/设备/签名
  geoLat        Decimal?  @db.Decimal(10,7)
  geoLng        Decimal?  @db.Decimal(10,7)
  geoAddress    String?   // 地理位置描述
  deviceInfo    Json?     // {device, appVersion}
  submittedAt   DateTime? // 提交时间
  
  // 新增：checklist进度跟踪
  checklistProgress Json?  // [{itemName, completed, completedAt}] 每个勾选项的完成状态
  
  // 新增：文件收集相关
  fileList      Json?     // [{fileName, filePath, fileSize, uploadedAt}] 上传的文件列表
  fileNamePrefix String?  // 文件命名前缀（船名_日期_）
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([shipId, templateId])
  @@index([teamCode, shipId])
  @@index([teamCode, templateType])
  @@index([status])
  @@index([progress])
  @@index([triggerDate])
}

// 共享文件表
model SharedFile {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  fileName      String    
  originalName  String    
  filePath      String    
  fileSize      Int       
  fileType      String    
  description   String?   
  category      String?   
  uploadedBy    Int       
  isPublic      Boolean   @default(true)
  downloadCount Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  uploader User @relation(fields: [uploadedBy], references: [id])
  comments   FileComment[]
  submissions FileSubmission[]

  @@index([teamCode])
  @@index([uploadedBy])
  @@index([category])
  @@index([isPublic])
}

// 文件评论表
model FileComment {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  fileId        Int
  userId        Int
  content       String
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  file SharedFile @relation(fields: [fileId], references: [id])

  @@index([teamCode, fileId])
  @@index([userId])
}

// 工作任务树表（XBLogbook迁移：任务模块）
model Task {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  title         String    
  description   String?   @db.Text
  parentId      Int?      
  category      String?   
  category2     String?   
  status        String    @default("pending")
  priority      Priority  @default(normal)
  dueDate       DateTime? 
  sortOrder     Int       @default(0)
  createdById   Int       
  assignedToId  Int?      

  createdBy     User      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedTo    User?     @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  parent        Task?     @relation("TaskChildren", fields: [parentId], references: [id])
  children      Task[]    @relation("TaskChildren")
  schedules     Schedule[]
  partyActivities PartyActivity[]

  ganttStartDate  DateTime? // 甘特图任务开始时间
  ganttEndDate    DateTime? // 甘特图任务结束时间
  targetCount     Int?      // 目标数量（多目标模式：如35艘船）
  ganttMode       String?   // 甘特图展示模式：multi-target/traditional/simple

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([teamCode])
  @@index([parentId])
  @@index([status])
  @@index([category])
  @@index([category2])
  @@index([dueDate])
  @@index([ganttStartDate])
  @@index([ganttEndDate])
}

// 经验分享表（XBLogbook迁移：经验分享模块）
model Experience {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  title         String    
  category      String    
  content       String    @db.Text
  authorId      Int       
  authorName    String    
  shipName      String?   
  rating        Float     @default(0)
  ratingCount   Int       @default(0)
  likeCount     Int       @default(0)
  viewCount     Int       @default(0)
  commentCount  Int       @default(0)
  attachmentUrl String?   

  author        User      @relation("ExperienceAuthor", fields: [authorId], references: [id])
  ratings       ExperienceRating[]
  comments      ExperienceComment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([teamCode])
  @@index([category])
  @@index([authorId])
  @@index([rating])
}

// 经验评分表
model ExperienceRating {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  experienceId  Int
  userId        Int
  rating        Int       

  experience Experience @relation(fields: [experienceId], references: [id])
  user User @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())

  @@unique([experienceId, userId])
  @@index([teamCode, experienceId])
}

// 经验评论表
model ExperienceComment {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  experienceId  Int
  userId        Int
  content       String    @db.Text
  parentId      Int?      // 父评论ID，支持二级嵌套
