// ============================================
// 诉求闭环管理模块（P3-2）
// ============================================

// 诉求状态枚举（完整闭环流程）
enum AppealStatusV2 {
  pending      // 待受理：船舶提交后等待主管受理
  accepted     // 已受理：主管已接收并开始处理
  processing   // 处理中：正在处理中
  escalated    // 已升级：已升级到上级处理
  resolved     // 已解决：主管已解决问题，等待船舶确认
  confirmed    // 已确认：船舶确认问题已解决，流程闭环
  closed       // 已关闭：流程结束（可由主管直接关闭）
  rejected     // 已驳回：不符合受理条件
}

// 诉求记录表
model CrewAppeal {
  id          Int       @id @default(autoincrement())
  teamCode    TeamCode
  crewId      Int
  crewName    String
  shipId      Int
  shipName    String
  title       String
  content     String
  category    String    // health | work | family | suggestion | complaint | other
  priority    String    @default("normal") // low | normal | high | urgent
  
  // 完整闭环状态机
  status      AppealStatusV2 @default(pending)
  
  // 诉求来源跟踪
  sourceTaskId Int?      // 来源任务ID（主管发布的任务收集）
  sourceTemplateId Int?  // 来源模板ID
  
  // 响应信息
  response    String?
  respondedBy Int?       // 处理人ID
  respondedAt DateTime?
  
  // 升级信息
  escalatedAt DateTime?
  escalatedTo String?
  
  // 解决与确认
  resolvedAt  DateTime?
  confirmedAt DateTime?  // 船舶确认时间
  confirmedBy Int?       // 确认人ID
  
  // 满意度评价（船舶确认时可评分）
  satisfaction Int?      // 满意度 1-5
  feedback    String?     // 船舶反馈意见
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // 状态流转记录
  statusTransitions AppealStatusTransition[]

  @@index([teamCode])
  @@index([crewId])
  @@index([shipId])
  @@index([status])
  @@index([priority])
  @@index([sourceTaskId])
  @@index([sourceTemplateId])
}

// 诉求状态流转记录表
model AppealStatusTransition {
  id          Int       @id @default(autoincrement())
  appealId    Int
  appeal      CrewAppeal @relation(fields: [appealId], references: [id], onDelete: Cascade)
  
  fromStatus  String?   // 流转前状态
  toStatus    String    // 流转后状态
  action      String    // 触发动作：submit/accept/process/resolve/confirm/close/reject/escalate
  operatorId  Int?      // 操作人ID
  operatorName String?  // 操作人姓名
  operatorRole String?  // 操作人角色：supervisor/ship
  
  // 流转详情
  comment     String?   // 操作备注/说明
  attachment  Json?    // 附件 [{name, url}]
  
  createdAt   DateTime  @default(now())

  @@index([appealId])
  @@index([createdAt])
}

// ============================================
// 客户端日志收集与AI分析系统
// ============================================

// 日志收集配置表（管理员控制）
model LogCollectionConfig {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  
  // 全局开关
  enabled       Boolean   @default(false)  // 是否启用日志收集
  
  // 收集级别
  collectErrors Boolean   @default(true)   // 收集JS错误
  collectApiErrors Boolean @default(true)  // 收集API错误
  collectPerformance Boolean @default(false) // 收集性能数据
  collectUserActions Boolean @default(false) // 收集用户操作
  
  // 上传配置
  uploadInterval Int      @default(300)     // 上传间隔（秒），默认5分钟
  maxBatchSize   Int      @default(50)      // 单次最大上传条数
  
  // 目标用户（空表示所有用户）
  targetUserIds Json?     // [1, 2, 3] 指定用户ID列表
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([teamCode])
  @@index([teamCode, enabled])
}

// 客户端日志表
model ClientLog {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  userId        Int
  
  // 日志类型
  logType       String    // error/api_error/performance/user_action
  level         String    // info/warn/error/critical
  
  // 日志内容
  message       String    @db.Text  // 错误消息/操作描述
  details       Json?     // 详细信息（堆栈、请求参数等）
  
  // 环境信息
  userAgent     String?   // 浏览器信息
  platform      String?   // 操作系统
  screenResolution String? // 屏幕分辨率
  networkType   String?   // 网络类型（4g/wifi等）
  
  // 页面信息
  pageUrl       String?   // 当前页面URL
  pagePath      String?   // 页面路径
  
  // 时间戳
  clientTime    DateTime  // 客户端时间
  createdAt     DateTime  @default(now())
  
  // 分析状态
  analyzed      Boolean   @default(false)  // 是否已AI分析
  analysisId    Int?     // 关联的分析结果
  analysis      LogAnalysis? @relation(fields: [analysisId], references: [id])
  
  @@index([teamCode, userId])
  @@index([teamCode, logType])
  @@index([teamCode, level])
  @@index([teamCode, analyzed])
  @@index([teamCode, createdAt])
  @@index([createdAt])
  @@index([clientTime])
  @@index([analysisId])
}

// AI分析结果表
model LogAnalysis {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  
  // 关联日志
  logIds        Json      // [1, 2, 3] 关联的日志ID列表
  logs          ClientLog[]
  
  // AI分析结果
  errorType     String?   // 错误类型分类
  rootCause     String?   @db.Text  // 根本原因分析
  suggestion    String?   @db.Text  // 修复建议
  
  // 严重级别
  severity      String    @default("medium") // low/medium/high/critical
  
  // 修复方案
  fixType       String?   // code_patch/config_change/user_guide
  fixContent    Json?     // 修复内容（代码补丁/配置/操作指导）
  
  // 状态
  status        String    @default("pending") // pending/fix_sent/resolved/ignored
  
  // 处理记录
  processedBy   Int?     // 处理人
  processedAt   DateTime? // 处理时间
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([teamCode, severity])
  @@index([teamCode, status])
  @@index([createdAt])
}

// 修复包表
model FixPackage {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  
  // 基本信息
  name          String    // 修复包名称
  description   String?   @db.Text  // 修复说明
  
  // 关联分析
  analysisId    Int?     // 关联的AI分析
  
  // 修复内容
  fixType       String    // code_patch/config_change/user_guide
  fixContent    Json      // 修复内容详情
  
  // 目标用户
  targetUserIds Json      // [1, 2, 3] 目标用户列表
  
  // 下发状态
  sentBy        Int       // 发送人
  sentAt        DateTime  @default(now())
  
  // 接收状态
  receivedCount Int       @default(0)  // 已接收人数
  appliedCount  Int       @default(0)  // 已应用人数
  
  receipts      FixPackageReceipt[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([teamCode])
  @@index([sentBy])
  @@index([sentAt])
}

// 修复包接收记录表
model FixPackageReceipt {
  id            Int       @id @default(autoincrement())
  packageId     Int
  userId        Int
  package       FixPackage @relation(fields: [packageId], references: [id])
  
  // 接收状态
  received      Boolean   @default(false)
  receivedAt    DateTime?
  
  // 应用状态
  applied       Boolean   @default(false)
  appliedAt     DateTime?
  
  // 反馈
  feedback      String?   @db.Text  // 用户反馈
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([packageId, userId])
  @@index([packageId])
  @@index([userId])
}

// ============================================
// 任务到期提醒Webhook模块
// ============================================

// 压缩记录表
model CompressionLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  fileName      String
  originalSize  Int
  compressedSize Int
  method        String   // 'image' | 'adobe' | 'original'
  compressionRate String
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Webhook类型枚举
enum WebhookType {
  dingtalk      // 钉钉
  feishu        // 飞书
  wechat        // 企业微信
  custom        // 自定义Webhook
}

// 提醒级别枚举
enum ReminderLevel {
  low           // 低 - 提前7天
  medium        // 中 - 提前3天
  high          // 高 - 提前1天
  urgent        // 紧急 - 提前0天（当天）
}

// Webhook配置表
model WebhookConfig {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  
  // Webhook基本信息
  name          String    // 配置名称，如"钉钉提醒"
  type          WebhookType @default(custom) // Webhook类型
  url           String    // Webhook地址URL
  
  // 加密配置
  secret        String?   // 签名密钥（钉钉/飞书使用）
  
  // 启用状态
  enabled       Boolean   @default(true)
  
  // 提醒配置
  reminderDays   Json      @default("[7, 3, 1]") // 提前提醒天数配置，如 [7, 3, 1] 表示提前7天、3天、1天提醒
  reminderLevels Json?     // 各级别对应天数 {"low": 7, "medium": 3, "high": 1, "urgent": 0}
  
  // 消息模板配置
  templateConfig Json?     // 自定义消息模板配置
  // 示例: {"title": "任务到期提醒", "content": "【{{taskTitle}}】任务将于{{daysLeft}}天后到期，请及时处理！"}
  
  // 过滤条件
  taskCategories Json?     // 只对指定分类的任务生效，如 ["党建活动", "安全检查"]
  priorityFilter Json?     // 只对指定优先级生效，如 ["urgent_important", "important"]
  
  // 责任人配置
  notifyCreator  Boolean   @default(true)  // 通知任务创建者
  notifyAssignee Boolean   @default(true)  // 通知任务负责人
  notifyAdmins   Boolean   @default(false) // 通知管理员
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // 关联发送记录
  sentLogs      WebhookSentLog[]
  
  @@index([teamCode])
  @@index([teamCode, enabled])
  @@index([type])
}

// Webhook发送记录表
model WebhookSentLog {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  
  // 关联配置
  webhookConfigId Int
  webhookConfig  WebhookConfig @relation(fields: [webhookConfigId], references: [id])
  
  // 关联任务
  taskId        Int?
  taskTitle     String?   // 冗余存储任务标题
  
  // 发送信息
  reminderLevel ReminderLevel // 提醒级别
  daysBefore   Int       // 提前多少天
  sentAt       DateTime  @default(now())
  
  // 发送结果
  success       Boolean   @default(false)
  responseCode Int?      // HTTP响应码
  responseBody String?   @db.Text  // 响应内容
  errorMessage String?    // 错误信息
  
  // 发送目标
  targetUsers   Json?     // 通知目标用户列表 [{"userId": 1, "name": "张三"}]
  
  @@index([teamCode])
  @@index([webhookConfigId])
  @@index([taskId])
  @@index([sentAt])
  @@index([success])
}

// 任务提醒记录表（记录已发送的提醒，避免重复发送）
model TaskReminderRecord {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  
  taskId        Int
  webhookConfigId Int?
  
  // 提醒信息
  reminderLevel ReminderLevel
  daysBefore   Int       // 提前多少天提醒
  dueDate      DateTime  // 任务截止日期
  
  // 发送状态
  sent         Boolean   @default(false)
  sentAt       DateTime?
  
  // 创建时间
  createdAt     DateTime  @default(now())
  
  @@unique([taskId, webhookConfigId, daysBefore])
  @@index([teamCode])
  @@index([taskId])
  @@index([sent])
}

// ============================================
// 杂志编排模块（AI杂志自动编排MVP）
// ============================================

// 杂志表
model Magazine {
  id          String   @id @default(uuid())
  name        String
  templateId  String
  totalPages  Int      @default(8)
  coverImage  String?
  status      String   @default("draft")  // draft, published
  teamCode    String?
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  articles    MagazineArticle[]
  sections    MagazineSection[]
  versions    MagazineVersion[]
}

// 杂志版块表
model MagazineSection {
  id          String   @id @default(uuid())
  magazineId  String
  name        String   // 如"新闻动态"
  pageStart   Int      @default(1)
  pageEnd     Int      @default(1)
  layout      String   @default("single-column")  // single-column, two-column, three-column
  order       Int      @default(0)
  magazine    Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  
  articles    MagazineArticle[]
  
  @@index([magazineId])
}

// 杂志文章表
model MagazineArticle {
  id          String   @id @default(uuid())
  magazineId  String
  sectionId   String?
  title       String
  content     String   // 富文本HTML
  author      String?
  summary     String?
  images      String[] // JSON数组
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  magazine    Magazine @relation(fields: [magazineId], references: [id], onDelete: Cascade)
  section     MagazineSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([magazineId])
  @@index([sectionId])
}

// 杂志版本历史表
model MagazineVersion {
  id            String   @id @default(uuid())
  magazineId    String
  versionNumber Int
  name          String?
  description   String?  // 版本描述，如"添加了3篇文章"
  data          Json     // 完整的杂志快照数据
  createdBy     Int
  createdAt     DateTime @default(now())

  magazine      Magazine @relation(fields: [magazineId], references: [id])

  @@unique([magazineId, versionNumber])
  @@index([magazineId])
}

// 杂志自动保存表
model MagazineAutoSave {
  id          String   @id @default(uuid())
  magazineId  String
  data        Json     // 临时自动保存数据
  createdAt   DateTime @default(now())
  expiresAt   DateTime // 24小时后过期

  @@index([magazineId])
}
