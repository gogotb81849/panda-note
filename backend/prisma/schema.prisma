  experience Experience @relation(fields: [experienceId], references: [id])
  user User @relation("ExperienceCommentUser", fields: [userId], references: [id])
  parent     ExperienceComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   ExperienceComment[] @relation("CommentReplies")
  createdAt     DateTime  @default(now())

  @@index([teamCode, experienceId])
  @@index([userId])
  @@index([parentId])
}

// 经验点赞表
model ExperienceLike {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  experienceId  Int
  userId        Int
  createdAt     DateTime  @default(now())

  @@unique([experienceId, userId])
  @@index([teamCode, experienceId])
}

// 经验分类表
model ExperienceCategory {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  name          String
  icon          String?
  color         String?
  parentId      Int?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  isExpanded    Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  parent        ExperienceCategory? @relation("CategoryChildren", fields: [parentId], references: [id])
  children      ExperienceCategory[] @relation("CategoryChildren")

  @@index([teamCode])
  @@index([parentId])
  @@index([sortOrder])
}

// 经验权限表
model ExperiencePermission {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  userId        Int
  permissionType String
  reason        String?
  expiresAt     DateTime?
  grantedBy     Int
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation("ExperiencePermissionUser", fields: [userId], references: [id])

  @@index([teamCode])
  @@index([userId])
  @@index([permissionType])
  @@index([isActive])
}

// ============================================
// 党建专项模块（第二阶段新增）
// ============================================

// 党建活动类型枚举
enum PartyActivityType {
  branch_meeting        // 支部党员大会
  committee_meeting     // 支委会
  party_group_meeting   // 党小组会
  party_lecture         // 党课
  theme_party_day       // 主题党日
  study_session         // 专题学习
  organizational_life   // 组织生活会
  democratic_review     // 民主评议
}

// 党建活动记录表（三会一课+主题党日+学习台账）
model PartyActivity {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  shipId        Int?      // 关联船舶（可选，岸基活动可为空）
  
  activityType  PartyActivityType  // 活动类型
  title         String    // 活动主题
  activityDate  DateTime  // 活动日期
  location      String?   // 活动地点
  hostName      String?   // 主持人
  recorderName  String?   // 记录人
  
  // 参会人员（JSON数组存储参会人员ID和姓名）
  attendees     Json      // [{userId: 1, name: "张三", role: "党员"}, ...]
  attendeeCount Int       @default(0)  // 参会人数
  
  // 活动内容
  agenda        String    @db.Text  // 议题/议程
  discussion    String?   @db.Text  // 讨论内容
  resolution    String?   @db.Text  // 决议/结论
  summary       String?   @db.Text  // 活动总结
  
  // 附件
  attachments   Json?     // [{fileName: "xxx.jpg", filePath: "/uploads/xxx.jpg"}, ...]
  
  // 关联信息
  relatedTaskId Int?      // 关联任务ID
  remarks       String?   @db.Text  // 备注
  
  // 统计字段
  likeCount     Int       @default(0)
  commentCount  Int       @default(0)
  
  // 审计字段
  createdById   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // 关联关系
  ship          Ship?     @relation(fields: [shipId], references: [id])
  task          Task?     @relation(fields: [relatedTaskId], references: [id])
  createdBy     User      @relation("PartyActivityCreatedBy", fields: [createdById], references: [id])
  comments      PartyActivityComment[]
  studyRecords  StudyRecord[]
  
  @@index([teamCode])
  @@index([teamCode, activityType])
  @@index([teamCode, activityDate])
  @@index([teamCode, shipId])
  @@index([createdById])
}

// 党建活动评论表
model PartyActivityComment {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  activityId    Int
  userId        Int
  content       String    @db.Text
  createdAt     DateTime  @default(now())
  
  activity      PartyActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user          User      @relation("PartyActivityCommentUser", fields: [userId], references: [id])
  
  @@index([teamCode, activityId])
  @@index([userId])
}

// 学习记录表（个人学习台账）
model StudyRecord {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  userId        Int       // 学习人员
  userName      String    // 学习人员姓名
  
  studyType     String    // 学习类型：政治理论/业务学习/安全培训/廉洁教育等
  title         String    // 学习主题
  studyDate     DateTime  // 学习日期
  studyMethod   String?   // 学习方式：集中/自学/线上/线下
  duration      Int?      // 学时（分钟）
  
  content       String    @db.Text  // 学习内容摘要
  notes         String?   @db.Text  // 学习笔记
  reflection    String?   @db.Text  // 心得体会
  
  // 关联信息
  relatedActivityId Int?  // 关联党建活动ID
  attachmentUrl   String? // 附件URL
  
  // 审核信息
  reviewedBy      Int?    // 审核人
  reviewedAt      DateTime? // 审核时间
  reviewStatus    String  @default("pending") // pending/approved/rejected
  reviewComment   String? // 审核意见
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation("StudyRecordUser", fields: [userId], references: [id])
  activity        PartyActivity? @relation(fields: [relatedActivityId], references: [id])
  
  @@index([teamCode])
  @@index([teamCode, userId])
  @@index([teamCode, studyDate])
  @@index([teamCode, studyType])
}

// ============================================
// 思想动态台账模块
// ============================================

// 情绪状态枚举
enum EmotionalState {
  stable        // 稳定
  fluctuating   // 波动
  anxious       // 焦虑
  depressed     // 低落
  angry         // 愤怒
  enthusiastic  // 积极
}

// 关注等级枚举
enum ConcernLevel {
  normal      // 正常
  attention   // 关注
  warning     // 预警
  critical    // 重点关注
}

// 思想动态报告表
model ThoughtReport {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  shipId        Int?      // 关联船舶
  userId        Int       // 报告人（政委）
  crewName      String    // 涉及船员姓名
  crewPosition  String?   // 船员岗位
  
  reportDate    DateTime  // 报告日期
  emotionalState EmotionalState  // 情绪状态
  concernLevel  ConcernLevel    // 关注等级
  
  // 动态内容
  situation     String    @db.Text  // 思想动态情况描述
  trigger       String?   @db.Text  // 触发原因
  measures      String?   @db.Text  // 已采取措施
  followUp      String?   @db.Text  // 后续跟进计划
  
  // 处理状态
  status        String    @default("open") // open/processing/closed
  closedAt      DateTime?
  closedBy      Int?
  
  // 关联信息
  relatedDiaryId Int?     // 关联日记ID
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation("ThoughtReportUser", fields: [userId], references: [id])
  
  @@index([teamCode])
  @@index([teamCode, reportDate])
  @@index([teamCode, emotionalState])
  @@index([teamCode, concernLevel])
  @@index([teamCode, status])
}

// ============================================
// 船员诉求管理模块
// ============================================

// 诉求类型枚举
enum AppealType {
  work_condition    // 工作条件
  life_welfare      // 生活福利
  career_development // 职业发展
  family_difficulty  // 家庭困难
  interpersonal      // 人际关系
  suggestion         // 意见建议
  complaint          // 投诉举报
  other              // 其他
}

// 诉求处理状态
enum AppealStatus {
  submitted     // 已提交
  acknowledged  // 已受理
  processing    // 处理中
  resolved      // 已解决
  rejected      // 已驳回
}

// 诉求记录表
model AppealRecord {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  shipId        Int?
  userId        Int       // 提交人
  
  appealType    AppealType
  title         String    // 诉求标题
  content       String    @db.Text  // 诉求内容
  urgency       String    @default("normal") // low/normal/urgent
  
  // 处理信息
  assignedTo    Int?      // 处理人
  status        AppealStatus @default(submitted)
  submittedAt   DateTime  @default(now())
  acceptedAt    DateTime?
  resolvedAt    DateTime?
  
  response      String?   @db.Text  // 处理回复
  satisfaction  Int?      // 满意度 1-5
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user          User      @relation("AppealRecordUser", fields: [userId], references: [id])
  
  @@index([teamCode])
  @@index([teamCode, status])
  @@index([teamCode, appealType])
  @@index([teamCode, submittedAt])
}

// ============================================
// 廉洁监督台账模块
// ============================================

// 廉洁监督类别
enum IntegrityCategory {
  meal_fund       // 伙食费管理
  union_fund      // 工会经费
  material        // 备件物料
  fuel_oil        // 燃油加装
  waste_oil       // 油污水处理
  gift_redpacket  // 礼品红包
  procurement     // 采购招标
  other           // 其他
}

// 风险等级
enum RiskLevel {
  low         // 低风险
  medium      // 中风险
  high        // 高风险
  critical    // 极高风险
}

// 检查类型
enum InspectionType {
  routine       // 例行检查
  special       // 专项检查
  surprise      // 突击检查
  follow_up     // 复查
}

// 廉洁监督记录表
model IntegrityRecord {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  shipId        Int?
  userId        Int       // 记录人
  
  category      IntegrityCategory  // 监督类别
  riskLevel     RiskLevel          // 风险等级
  inspectionType InspectionType    // 检查类型
  
  inspectionDate DateTime   // 检查日期
  title         String     // 检查标题
  findings      String     @db.Text  // 发现的问题
  evidence      Json?      // 证据材料 [{type, url, description}]
  
  // 处理信息
  measures      String?    @db.Text  // 整改措施
  deadline      DateTime?  // 整改期限
  responsible   String?    // 责任人
  status        String     @default("open") // open/in_progress/resolved/closed
  resolvedAt    DateTime?
  resolvedBy    Int?
  
  // 预警信息
  alertSent     Boolean    @default(false)
  alertLevel    String?    // 预警等级
  
  remarks       String?    @db.Text
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  user          User       @relation("IntegrityRecordUser", fields: [userId], references: [id])
  
  @@index([teamCode])
  @@index([teamCode, category])
  @@index([teamCode, riskLevel])
  @@index([teamCode, status])
  @@index([teamCode, inspectionDate])
}

// ============================================
// 政委履职档案模块
// ============================================

// 政委能力评级
enum OfficerGrade {
  excellent     // 优秀
  good          // 良好
  qualified     // 合格
  needs_improve // 需改进
  unqualified   // 不合格
}

// 政委履职档案表
model OfficerProfile {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  userId        Int       // 政委用户ID
  
  // 基本信息
  shipId        Int?      // 当前任职船舶
  appointmentDate DateTime // 上船日期
  expectedEndDate DateTime? // 预期下船日期
  
  // 派前信息
  preTalk       String?    @db.Text  // 派前谈话记录
  preTalkDate   DateTime?
  preTalkBy     Int?       // 谈话人
  
  // 传帮带计划
  mentorPlan    String?    @db.Text  // 传帮带计划
  mentorName    String?    // 导师姓名
  mentorId      Int?
  
  // 能力评估
  overallGrade  OfficerGrade? // 总体评级
  strengths     String?    @db.Text  // 优势
  weaknesses    String?    @db.Text  // 不足
  improvePlan   String?    @db.Text  // 改进计划
  
  // 统计信息（自动计算）
  diaryCount    Int        @default(0)  // 日记数量
  activityCount Int        @default(0)  // 党建活动数量
  studyCount    Int        @default(0)  // 学习记录数量
  activeDays    Int        @default(0)  // 活跃天数
  lastActiveAt  DateTime?  // 最后活跃时间
  
  // 特殊标记
  isThin        Boolean    @default(false)  // 能力薄弱标记
  isNewbie      Boolean    @default(false)  // 新政委标记
  focusAreas    Json?      // 重点关注领域
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  user          User       @relation("OfficerProfileUser", fields: [userId], references: [id])
  evaluations   OfficerEvaluation[] @relation("EvaluationOfficer")
  mentorships   MentorshipRecord[] @relation("MentorshipMentee")
  
  @@unique([teamCode, userId])
  @@index([teamCode])
  @@index([teamCode, overallGrade])
}

// 考核评价表
model OfficerEvaluation {
  id            Int       @id @default(autoincrement())
  teamCode      TeamCode
  officerProfileId Int   // 履职档案ID
  officerId     Int       // 被评价政委
  evaluatorId   Int       // 评价人（主管）
  
  evalDate      DateTime  // 评价日期
  evalType      String    // 月度/季度/年度/专项
  
  // 评分项
  partyWork     Int?      // 党建工作 1-5
