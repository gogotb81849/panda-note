  createdAt     DateTime  @default(now())
  
  officerProfile OfficerProfile @relation("EvaluationOfficer", fields: [officerProfileId], references: [id])
  officer       User      @relation("EvaluationOfficerUser", fields: [officerId], references: [id])
  evaluator     User      @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id])
  
  @@index([teamCode])
  @@index([teamCode, officerProfileId])
  @@index([teamCode, evalDate])
}

// 传帮带记录表
