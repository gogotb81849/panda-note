{
  "name": "nav-log-backend",
  "version": "1.1.0.0867",
  "description": "熊猫笔记 - 船舶政工智慧台账管理系统后端API服务",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "node scripts/sync-version.mjs",
    "build": "nest build",
    "postinstall": "node -e \"try{const fs=require('fs'),cp=require('child_process');if(process.env.GITHUB_ACTIONS){console.log('[self-heal] GITHUB_ACTIONS detected → skip (deploy workflow handles PM2 restart)');process.exit(0);}const ok=fs.existsSync('/www/wwwroot/nav-log-system');let hasPm2=false;try{cp.execSync('which pm2',{stdio:'ignore'});hasPm2=true;}catch(_){}if(!ok||!hasPm2){console.log('[self-heal] skip');process.exit(0);}console.log('[self-heal] server env → pm2 delete old');function r(c){try{console.log('  $ '+c);console.log(cp.execSync(c+' 2>&1 || true',{encoding:'utf8',timeout:15000}).trim());}catch(e){console.log('  safe-ignore '+String(e.message||e));}}r('pm2 delete nav-log-backend');r('pm2 delete nav-log-frontend');try{cp.execSync('sleep 3',{stdio:'ignore'});}catch(_){}r('pm2 save');console.log('[self-heal] done');}catch(e){console.log('[self-heal] safe error: '+String(e.message||e));}process.exit(0);\" || exit 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "prestart:dev": "node scripts/sync-version.mjs",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "5.22.0",
    "axios": "^1.6.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.79.2",
    "canvas": "^2.11.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "exceljs": "^4.4.0",
    "ioredis": "^5.11.1",
    "mammoth": "^1.6.0",
    "marked": "^11.0.0",
    "opencc-js": "^1.4.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.9",
    "@types/passport-local": "^1.0.35",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
