# ============================================================
# 熊猫笔记 - 后端环境变量（示例）
#
# 使用方法：
#   1. 复制本文件为 .env：
#      cp .env.example .env
#   2. 根据实际情况修改下面的值
#
# ⚠️ 生产环境部署前必改项：
#   1. DATABASE_URL - 更换为生产数据库连接字符串
#   2. JWT_SECRET - 使用强随机字符串（见下方生成命令）
#   3. AI_API_KEY - 更换为真实 AI API 密钥
#   4. FRONTEND_URL - 配置正式域名（CORS 白名单）
#
# 生成 JWT_SECRET 命令：
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================

# 运行环境：development | production
NODE_ENV="development"

# 服务端口
PORT=3002

# 数据库连接字符串
DATABASE_URL="postgresql://user:password@host:5432/navlog?schema=public"

# JWT 密钥（生产环境必须使用 64 位以上随机字符串）
JWT_SECRET="your-secret-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# 前端 URL（CORS 白名单，多个以英文逗号分隔）
FRONTEND_URL="http://localhost:3001,http://localhost:3000"

# 豆包 / 火山引擎 AI API 配置
AI_API_URL="https://ark.cn-beijing.volces.com/api/v3/chat/completions"
AI_API_KEY="your-ai-api-key"
AI_ENDPOINT_ID="your-endpoint-id"
